{
  "compilerOptions": {
    "module": "ESNext",                                
    // "rootDir": "./src",
    "outDir": "./dist",  
    "target": "ES2023",
    "moduleResolution": "bundler", 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "prisma","generated/**/*"]
}